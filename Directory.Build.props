<Project>

  <!--
    Directory.Build.props — Solution-wide MSBuild properties.
    Applied to ALL projects before their .csproj is evaluated.
    Place project-specific overrides inside the .csproj file.
  -->

  <PropertyGroup Label="SDK Defaults">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Build Quality">
    <!-- Treat warnings as errors in CI / Release builds -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true' or '$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- CS1591 = Missing XML comment for publicly visible type/member (opt-in later) -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Artifacts">
    <!-- All binaries go under a single root for easier tooling -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Test project defaults — detected by naming convention *.Tests -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    ═══════════════════════════════════════════════════════════════════════
    Module layer defaults — applied by naming convention.
    Every HRM.Modules.*.{Layer} project automatically inherits the
    BuildingBlocks dependency and shared packages for its layer.
    ═══════════════════════════════════════════════════════════════════════
  -->

  <!-- *.Domain → BuildingBlocks.Domain -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) And $(MSBuildProjectName.EndsWith('.Domain'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/HRM.BuildingBlocks.Domain/HRM.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <!-- *.IntegrationEvents → BuildingBlocks.Domain -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) And $(MSBuildProjectName.EndsWith('.IntegrationEvents'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/HRM.BuildingBlocks.Domain/HRM.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <!-- *.Application → FluentValidation + MediatR + BuildingBlocks.Application -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) And $(MSBuildProjectName.EndsWith('.Application'))">
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MediatR" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/HRM.BuildingBlocks.Application/HRM.BuildingBlocks.Application.csproj" />
  </ItemGroup>

  <!-- *.Infrastructure → EF Core + MediatR + BuildingBlocks.Infrastructure -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) And $(MSBuildProjectName.EndsWith('.Infrastructure'))">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="MediatR" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/HRM.BuildingBlocks.Infrastructure/HRM.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <!-- *.Api → OpenApi + MediatR + BuildingBlocks.Infrastructure -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) And $(MSBuildProjectName.EndsWith('.Api'))">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MediatR" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/BuildingBlocks/HRM.BuildingBlocks.Infrastructure/HRM.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

</Project>
