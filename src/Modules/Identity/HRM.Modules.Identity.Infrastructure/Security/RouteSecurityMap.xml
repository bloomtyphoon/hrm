<?xml version="1.0" encoding="UTF-8"?>
<RouteSecurityMap Module="Identity" Version="2.0" xmlns="http://hrm.system/route-security">
  <!--
    Identity Module Route Security Map
    Maps API routes to permissions
  -->

  <!-- Public Routes - No authentication required -->
  <PublicRoutes>
    <Route Method="POST" Path="/api/identity/auth/login" />
    <Route Method="POST" Path="/api/identity/auth/refresh" />
    <Route Method="GET" Path="/api/identity/auth/me" />
    <Route Method="GET" Path="/health" />
  </PublicRoutes>

  <!-- Protected Routes - Require authentication and specific permissions -->
  <ProtectedRoutes>

    <!-- ==================== Account Management ==================== -->

    <!-- List accounts (paginated) -->
    <Route
        Method="GET"
        Path="/api/identity/accounts"
        Permission="Identity.Account.View" />

    <!-- Get account by ID -->
    <Route
        Method="GET"
        Path="/api/identity/accounts/{id}"
        Permission="Identity.Account.View" />

    <!-- Register new account -->
    <Route
        Method="POST"
        Path="/api/identity/accounts/register"
        Permission="Identity.Account.Create" />

    <!-- Activate account -->
    <Route
        Method="POST"
        Path="/api/identity/accounts/{id}/activate"
        Permission="Identity.Account.Update" />

    <!-- Update account -->
    <Route
        Method="PUT"
        Path="/api/identity/accounts/{id}"
        Permission="Identity.Account.Update" />

    <!-- Delete account -->
    <Route
        Method="DELETE"
        Path="/api/identity/accounts/{id}"
        Permission="Identity.Account.Delete" />

    <!-- Reset account password -->
    <Route
        Method="POST"
        Path="/api/identity/accounts/{id}/reset-password"
        Permission="Identity.Account.ResetPassword" />

    <!-- Assign role to account -->
    <Route
        Method="POST"
        Path="/api/identity/accounts/{id}/roles"
        Permission="Identity.Account.AssignRole" />

    <!-- ==================== Role Management ==================== -->

    <!-- List roles -->
    <Route
        Method="GET"
        Path="/api/identity/roles"
        Permission="Identity.Role.View" />

    <!-- Get role by ID -->
    <Route
        Method="GET"
        Path="/api/identity/roles/{id}"
        Permission="Identity.Role.View" />

    <!-- Create role -->
    <Route
        Method="POST"
        Path="/api/identity/roles"
        Permission="Identity.Role.Create" />

    <!-- Update role -->
    <Route
        Method="PUT"
        Path="/api/identity/roles/{id}"
        Permission="Identity.Role.Update" />

    <!-- Delete role -->
    <Route
        Method="DELETE"
        Path="/api/identity/roles/{id}"
        Permission="Identity.Role.Delete" />

    <!-- Assign permissions to role -->
    <Route
        Method="POST"
        Path="/api/identity/roles/{id}/permissions"
        Permission="Identity.Role.AssignPermission" />

    <!-- ==================== Session Management ==================== -->

    <!-- Get active sessions -->
    <Route
        Method="GET"
        Path="/api/identity/sessions"
        Permission="Identity.Account.View" />

    <!-- Revoke session -->
    <Route
        Method="DELETE"
        Path="/api/identity/sessions/{id}"
        Permission="Identity.Account.Update" />

    <!-- Logout (revoke current session) -->
    <Route
        Method="POST"
        Path="/api/identity/auth/logout"
        Permission="Identity.Account.Update" />

  </ProtectedRoutes>

</RouteSecurityMap>
