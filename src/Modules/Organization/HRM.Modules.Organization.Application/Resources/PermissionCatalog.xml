<?xml version="1.0" encoding="UTF-8"?>
<PermissionCatalog Module="Organization" Version="1.0" xmlns="http://hrm.system/permissions">
  <!--
    Organization Module Permission Catalog
    Defines all permissions for company, department, and position management.

    This file is embedded as a resource and loaded via IPermissionCatalogSourceFactory.

    Scope Hierarchy (matches DataScopeLevel enum):
    - None (0): No access - explicit deny
    - Self (1): Only own data
    - EmployeeSet (2): Manager's subordinates (hierarchical scope)
    - Position (3): Same position group
    - Department (4): Same department
    - Company (5): Whole company access
    - Global (6): System-wide access (super admin)
  -->

  <Permissions>

    <Module name="Organization" displayName="Quản lý tổ chức">

      <!-- Company Entity -->
      <Entity name="Company" displayName="Công ty">

        <Action name="View" displayName="Xem công ty" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

        <Action name="Create" displayName="Tạo công ty" defaultScope="Global">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
          </Scopes>
        </Action>

        <Action name="Update" displayName="Cập nhật công ty" defaultScope="Global">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

      </Entity>

      <!-- Department Entity -->
      <Entity name="Department" displayName="Phòng ban">

        <Action name="View" displayName="Xem phòng ban" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
            <Scope value="Department" displayName="Cùng phòng ban" />
          </Scopes>
        </Action>

        <Action name="Create" displayName="Tạo phòng ban" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

        <Action name="Update" displayName="Cập nhật phòng ban" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

      </Entity>

      <!-- Position Entity -->
      <Entity name="Position" displayName="Vị trí">

        <Action name="View" displayName="Xem vị trí" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
            <Scope value="Department" displayName="Cùng phòng ban" />
          </Scopes>
        </Action>

        <Action name="Create" displayName="Tạo vị trí" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

        <Action name="Update" displayName="Cập nhật vị trí" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

      </Entity>

      <!-- Tenant Entity - System Administrators only (Global scope required) -->
      <Entity name="Tenant" displayName="Tenant">

        <Action name="View" displayName="Xem tenant" defaultScope="Global">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
          </Scopes>
        </Action>

        <Action name="Create" displayName="Tạo tenant" defaultScope="Global">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
          </Scopes>
        </Action>

        <Action name="Update" displayName="Cập nhật tenant" defaultScope="Global">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
          </Scopes>
        </Action>

      </Entity>

    </Module>

  </Permissions>

</PermissionCatalog>
