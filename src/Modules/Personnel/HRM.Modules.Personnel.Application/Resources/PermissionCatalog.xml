<?xml version="1.0" encoding="UTF-8"?>
<PermissionCatalog Module="Personnel" Version="1.0" xmlns="http://hrm.system/permissions">
  <!--
    Personnel Module Permission Catalog
    Defines all permissions for employee and assignment management.

    This file is embedded as a resource and loaded via IPermissionCatalogSourceFactory.

    Scope Hierarchy (matches DataScopeLevel enum):
    - None (0): No access - explicit deny
    - Self (1): Only own data
    - EmployeeSet (2): Manager's subordinates (hierarchical scope)
    - Position (3): Same position group
    - Department (4): Same department
    - Company (5): Whole company access
    - Global (6): System-wide access (super admin)
  -->

  <!-- Scope Definitions (reusable) - matches DataScopeLevel enum -->
  <ScopeDefinitions>
    <Scope Name="None" Level="0" DisplayName="Không có quyền" />
    <Scope Name="Self" Level="1" DisplayName="Chỉ bản thân" />
    <Scope Name="EmployeeSet" Level="2" DisplayName="Nhân viên cấp dưới" />
    <Scope Name="Position" Level="3" DisplayName="Cùng vị trí" />
    <Scope Name="Department" Level="4" DisplayName="Cùng phòng ban" />
    <Scope Name="Company" Level="5" DisplayName="Toàn công ty" />
    <Scope Name="Global" Level="6" DisplayName="Toàn hệ thống" />
  </ScopeDefinitions>

  <Permissions>

    <Module name="Personnel" displayName="Quản lý nhân sự">

      <!-- Employee Entity -->
      <Entity name="Employee" displayName="Nhân viên">

        <Action name="View" displayName="Xem nhân viên" defaultScope="Self">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
            <Scope value="EmployeeSet" displayName="Nhân viên cấp dưới" />
            <Scope value="Self" displayName="Chỉ bản thân" />
          </Scopes>
        </Action>

        <Action name="Create" displayName="Tạo nhân viên" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

        <Action name="Update" displayName="Cập nhật nhân viên" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
            <Scope value="EmployeeSet" displayName="Nhân viên cấp dưới" />
          </Scopes>
        </Action>

        <Action name="Terminate" displayName="Kết thúc hợp đồng" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

      </Entity>

      <!-- Assignment Entity - Employee-Company assignments -->
      <Entity name="Assignment" displayName="Phân công nhân viên">

        <Action name="View" displayName="Xem phân công" defaultScope="Self">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
            <Scope value="EmployeeSet" displayName="Nhân viên cấp dưới" />
            <Scope value="Self" displayName="Chỉ bản thân" />
          </Scopes>
        </Action>

        <Action name="Create" displayName="Tạo phân công" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

        <Action name="Update" displayName="Cập nhật phân công" defaultScope="Company">
          <Scopes>
            <Scope value="Global" displayName="Toàn hệ thống" />
            <Scope value="Company" displayName="Toàn công ty" />
          </Scopes>
        </Action>

      </Entity>

    </Module>

  </Permissions>

</PermissionCatalog>
