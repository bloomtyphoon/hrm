<?xml version="1.0" encoding="UTF-8"?>
<RouteSecurityMap Module="Attendance" Version="1.0" xmlns="http://hrm.system/route-security">
  <!--
    Attendance Module Route Security Map
    Maps API routes to required permissions.
  -->

  <!-- Public Routes - No authentication required -->
  <PublicRoutes>
  </PublicRoutes>

  <!-- Protected Routes - Require authentication and specific permissions -->
  <ProtectedRoutes>

    <!-- ==================== Self Check-In / Check-Out ==================== -->

    <!-- Employee checks in (self) -->
    <Route
        Method="POST"
        Path="/api/attendance/check-in"
        Permission="Attendance.Record.CheckIn" />

    <!-- Employee checks out (self) -->
    <Route
        Method="POST"
        Path="/api/attendance/check-out"
        Permission="Attendance.Record.CheckOut" />

    <!-- ==================== Attendance History ==================== -->

    <!-- Current user's own attendance history -->
    <Route
        Method="GET"
        Path="/api/attendance/me"
        Permission="Attendance.Record.View" />

    <!-- View specific employee's attendance (manager/HR) -->
    <Route
        Method="GET"
        Path="/api/attendance/employees/{employeeId}"
        Permission="Attendance.Record.View" />

    <!-- View a specific attendance record by ID -->
    <Route
        Method="GET"
        Path="/api/attendance/records/{id}"
        Permission="Attendance.Record.View" />

    <!-- ==================== HR Manual Record ==================== -->

    <!-- HR manually records attendance for an employee -->
    <Route
        Method="POST"
        Path="/api/attendance/records"
        Permission="Attendance.Record.ManualRecord" />

    <!-- ==================== HR Update / Delete Record ==================== -->

    <!-- HR updates an existing attendance record -->
    <Route
        Method="PUT"
        Path="/api/attendance/records/{id}"
        Permission="Attendance.Record.Update" />

    <!-- HR deletes an attendance record -->
    <Route
        Method="DELETE"
        Path="/api/attendance/records/{id}"
        Permission="Attendance.Record.Delete" />

    <!-- ==================== Shifts ==================== -->

    <Route Method="GET" Path="/api/attendance/shifts" Permission="Attendance.Shift.View" />
    <Route Method="POST" Path="/api/attendance/shifts" Permission="Attendance.Shift.Manage" />
    <Route Method="PUT" Path="/api/attendance/shifts/{id}" Permission="Attendance.Shift.Manage" />
    <Route Method="DELETE" Path="/api/attendance/shifts/{id}" Permission="Attendance.Shift.Manage" />

    <!-- ==================== Shift Assignments ==================== -->

    <Route Method="GET" Path="/api/attendance/shift-assignments" Permission="Attendance.Shift.View" />
    <Route Method="POST" Path="/api/attendance/shift-assignments" Permission="Attendance.Shift.Assign" />

    <!-- ==================== Leave Types ==================== -->

    <Route Method="GET" Path="/api/attendance/leave-types" Permission="Attendance.Leave.ViewTypes" />
    <Route Method="POST" Path="/api/attendance/leave-types" Permission="Attendance.Leave.ManageTypes" />

    <!-- ==================== Leave Requests ==================== -->

    <Route Method="GET" Path="/api/attendance/leave-requests" Permission="Attendance.Leave.ViewRequests" />
    <Route Method="POST" Path="/api/attendance/leave-requests" Permission="Attendance.Leave.Request" />
    <Route Method="POST" Path="/api/attendance/leave-requests/{id}/approve" Permission="Attendance.Leave.Approve" />
    <Route Method="POST" Path="/api/attendance/leave-requests/{id}/cancel" Permission="Attendance.Leave.CancelRequest" />

    <!-- ==================== Leave Approval Settings ==================== -->

    <Route Method="GET" Path="/api/attendance/leave-approval-settings" Permission="Attendance.Leave.ManageSettings" />
    <Route Method="PUT" Path="/api/attendance/leave-approval-settings" Permission="Attendance.Leave.ManageSettings" />

  </ProtectedRoutes>

</RouteSecurityMap>
