@model DepartmentListViewModel

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Departments</h2>
</div>

@if (Model.RequiresCompanySelection)
{
    <div class="alert alert-warning">
        <i class="bi bi-info-circle me-2"></i>
        Please select a specific company from the <strong>Company Switcher</strong> in the navigation bar to view departments.
    </div>
}
else
{
    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by code or name..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Departments Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Departments.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-diagram-3 display-4 text-muted"></i>
                    <p class="mt-3 text-muted">No departments found.</p>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <a asp-action="Index" class="btn btn-link">Clear filters</a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Level</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.Departments)
                            {
                                <tr>
                                    <td><code>@dept.Code</code></td>
                                    <td>
                                        @if (dept.Level > 0)
                                        {
                                            <span class="text-muted">@(new string('\u2003', dept.Level))</span>
                                        }
                                        @dept.Name
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@dept.Level</span>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = dept.Status switch
                                            {
                                                "Active" => "bg-success",
                                                "Inactive" => "bg-secondary",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@dept.Status</span>
                                    </td>
                                    <td>
                                        <span title="@dept.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                            @dept.CreatedAtUtc.ToString("yyyy-MM-dd")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted mt-3">
                    Showing @Model.Departments.Count departments
                </div>
            }
        </div>
    </div>
}
