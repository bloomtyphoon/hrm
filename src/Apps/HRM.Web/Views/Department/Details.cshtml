@model DepartmentDetailViewModel

@{
    ViewData["Title"] = $"Department - {Model.Department.Name}";
    var dept = Model.Department;
}

<div class="row">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@dept.Name</h2>
            @{
                var badgeClass = dept.Status switch
                {
                    "Active" => "bg-success",
                    "Inactive" => "bg-secondary",
                    "Restructuring" => "bg-warning text-dark",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @badgeClass fs-6">@dept.Status</span>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <i class="bi bi-diagram-3 me-1"></i>Department Details
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Department ID</dt>
                    <dd class="col-sm-8"><code>@dept.Id</code></dd>

                    <dt class="col-sm-4">Code</dt>
                    <dd class="col-sm-8"><code>@dept.Code</code></dd>

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@dept.Name</dd>

                    <dt class="col-sm-4">Level</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark">@dept.Level</span></dd>

                    <dt class="col-sm-4">Parent Department</dt>
                    <dd class="col-sm-8">
                        @if (dept.ParentDepartmentId.HasValue)
                        {
                            <a asp-action="Details" asp-route-id="@dept.ParentDepartmentId">@(Model.ParentDepartmentName ?? dept.ParentDepartmentId.ToString())</a>
                        }
                        else
                        {
                            <em>None (Top-level)</em>
                        }
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @badgeClass">@dept.Status</span></dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@dept.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                    <dt class="col-sm-4">Last Modified</dt>
                    <dd class="col-sm-8">
                        @if (dept.ModifiedAtUtc.HasValue)
                        {
                            @dept.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")
                            <text> UTC</text>
                        }
                        else
                        {
                            <em>Never modified</em>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Manager Section -->
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-badge me-1"></i>Manager</span>
            </div>
            <div class="card-body">
                @if (dept.ManagerId.HasValue)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-controller="Employee" asp-action="Details" asp-route-id="@dept.ManagerId">
                                <i class="bi bi-person me-1"></i>@(Model.ManagerName ?? dept.ManagerId.ToString())
                            </a>
                        </div>
                        <form asp-action="RemoveManager" asp-route-id="@dept.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this manager from the department?')">
                                <i class="bi bi-x-circle me-1"></i>Remove
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-2">No manager assigned</p>
                }
                <hr />
                <form asp-action="AssignManager" asp-route-id="@dept.Id" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-auto flex-grow-1">
                        <label class="form-label form-label-sm">Assign Manager</label>
                        <select name="managerId" class="form-select form-select-sm" required>
                            <option value="">-- Select Employee --</option>
                            @foreach (var emp in Model.AvailableEmployees)
                            {
                                <option value="@emp.Id">@emp.FullName (@emp.EmployeeCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-person-check me-1"></i>Assign
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Move Department Section -->
        <div class="card mt-3">
            <div class="card-header">
                <i class="bi bi-arrows-move me-1"></i>Move Department
            </div>
            <div class="card-body">
                <form asp-action="Move" asp-route-id="@dept.Id" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-auto flex-grow-1">
                        <label class="form-label form-label-sm">New Parent Department</label>
                        <select name="newParentDepartmentId" class="form-select form-select-sm">
                            <option value="">-- None (Top-level) --</option>
                            @foreach (var d in Model.AvailableDepartments)
                            {
                                var selected = d.Id == dept.ParentDepartmentId ? "selected" : "";
                                <option value="@d.Id" @selected>@d.Name (@d.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Move this department to a new parent?')">
                            <i class="bi bi-arrows-move me-1"></i>Move
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            @if (dept.Status != "Active")
            {
                <form asp-action="Activate" asp-route-id="@dept.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to activate this department?')">
                        <i class="bi bi-check-circle me-1"></i>Activate
                    </button>
                </form>
            }
            @if (dept.Status == "Active")
            {
                <form asp-action="Deactivate" asp-route-id="@dept.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning" onclick="return confirm('Are you sure you want to deactivate this department?')">
                        <i class="bi bi-pause-circle me-1"></i>Deactivate
                    </button>
                </form>
            }
        </div>
    </div>
</div>
