@model CreateCompanyRequest

@{
    ViewData["Title"] = "Create Company";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Create New Company</h2>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" placeholder="Enter company code" />
                <span asp-validation-for="Code" class="text-danger"></span>
                <div class="form-text">
                    Company code must be 1-50 characters and contain only letters, numbers, underscores, or hyphens.
                    <br />
                    Examples: ABC-001, COMPANY_01, HRM123
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter company name" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <div class="form-text">Company name (1-200 characters).</div>
            </div>

            <div class="mb-3">
                <label asp-for="TaxId" class="form-label"></label>
                <input asp-for="TaxId" class="form-control" placeholder="Enter tax ID (optional)" />
                <span asp-validation-for="TaxId" class="text-danger"></span>
                <div class="form-text">Tax identification number (optional, max 50 characters).</div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-building me-1"></i>Create Company
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
