@model CompanyListViewModel

@{
    ViewData["Title"] = "Companies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Companies</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Create Company
    </a>
</div>

<!-- Search and Filter -->
<form method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by code or name..." />
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" name="status">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="bi bi-funnel me-1"></i>Filter
            </button>
        </div>
    </div>
</form>

<!-- Companies Table -->
@if (Model.Companies.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No companies found.
        <a asp-action="Create" class="alert-link">Create your first company</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Tax ID</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var company in Model.Companies)
                {
                    <tr>
                        <td><code>@company.Code</code></td>
                        <td>@company.Name</td>
                        <td>@(company.TaxId ?? "-")</td>
                        <td>
                            @{
                                var badgeClass = company.Status switch
                                {
                                    "Active" => "bg-success",
                                    "Inactive" => "bg-secondary",
                                    "Pending" => "bg-warning text-dark",
                                    _ => "bg-light text-dark"
                                };
                            }
                            <span class="badge @badgeClass">@company.Status</span>
                        </td>
                        <td>@company.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
