@model RoleDetailViewModel

@{
    ViewData["Title"] = $"Role: {Model.Role.Name}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Role.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.Role.Name</h2>
        <div class="d-flex gap-2">
            @{
                var typeBadgeClass = Model.Role.RoleType == "System" ? "bg-primary" : "bg-info";
                var statusBadgeClass = Model.Role.IsActive ? "bg-success" : "bg-secondary";
            }
            <span class="badge @typeBadgeClass">@Model.Role.RoleType Role</span>
            <span class="badge @statusBadgeClass">@(Model.Role.IsActive ? "Active" : "Inactive")</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Permissions" asp-route-id="@Model.Role.Id" class="btn btn-outline-info">
            <i class="bi bi-key me-1"></i>Manage Permissions
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Role.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Role.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger"
                    onclick="return confirm('Are you sure you want to delete this role?')">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Role Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8"><code>@Model.Role.Id</code></dd>

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Role.Name</dd>

                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">@Model.Role.RoleType</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @statusBadgeClass">@(Model.Role.IsActive ? "Active" : "Inactive")</span>
                    </dd>

                    <dt class="col-sm-4">Company</dt>
                    <dd class="col-sm-8">
                        @if (Model.Role.CompanyId.HasValue)
                        {
                            <span class="badge bg-info"><i class="bi bi-building me-1"></i>Company-scoped</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-globe me-1"></i>Global</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@(Model.Role.Description ?? "-")</dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Role.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                    @if (Model.Role.ModifiedAtUtc.HasValue)
                    {
                        <dt class="col-sm-4">Modified</dt>
                        <dd class="col-sm-8">@Model.Role.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-shield-check me-2"></i>Permissions (@Model.Role.Permissions.Count)</h6>
                <a asp-action="Permissions" asp-route-id="@Model.Role.Id" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-pencil me-1"></i>Edit Permissions
                </a>
            </div>
            <div class="card-body">
                @if (Model.Role.Permissions.Count == 0)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-shield-x display-4 text-muted"></i>
                        <p class="mt-3 text-muted">No permissions assigned to this role.</p>
                        <a asp-action="Permissions" asp-route-id="@Model.Role.Id" class="btn btn-outline-info">
                            <i class="bi bi-plus-circle me-1"></i>Add Permissions
                        </a>
                    </div>
                }
                else
                {
                    var groupedPermissions = Model.Role.Permissions
                        .GroupBy(p => p.Module)
                        .OrderBy(g => g.Key);
                    <div class="accordion" id="permissionsAccordion">
                        @foreach (var moduleGroup in groupedPermissions)
                        {
                            var moduleId = $"module-{moduleGroup.Key}";
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@moduleId">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@moduleId">
                                        <strong>@moduleGroup.Key</strong>
                                        <span class="badge bg-secondary ms-2">@moduleGroup.Count()</span>
                                    </button>
                                </h2>
                                <div id="collapse-@moduleId" class="accordion-collapse collapse show" data-bs-parent="#permissionsAccordion">
                                    <div class="accordion-body">
                                        <div class="row">
                                            @{
                                                var entityGroups = moduleGroup.GroupBy(p => p.Entity).OrderBy(g => g.Key);
                                            }
                                            @foreach (var entityGroup in entityGroups)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <h6 class="text-muted mb-2">@entityGroup.Key</h6>
                                                    @foreach (var perm in entityGroup.OrderBy(p => p.Action))
                                                    {
                                                        <div class="d-flex align-items-center mb-1">
                                                            <span class="badge bg-light text-dark me-2">@perm.Action</span>
                                                            @if (!string.IsNullOrEmpty(perm.Scope))
                                                            {
                                                                <small class="text-muted">(@perm.Scope)</small>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
