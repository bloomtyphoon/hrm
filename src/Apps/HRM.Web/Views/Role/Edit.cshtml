@model UpdateRoleRequest

@{
    ViewData["Title"] = "Edit Role";
    var roleId = ViewBag.RoleId as Guid?;
    var roleType = ViewBag.RoleType as string ?? "Employee";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@roleId">@Model.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Role</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@roleId" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label">Role Type</label>
                        <input type="text" class="form-control" value="@roleType" disabled />
                        <div class="form-text">Role type cannot be changed after creation.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                        <div class="form-text">Inactive roles cannot be assigned to accounts.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@roleId" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-key me-2"></i>Permissions</h6>
            </div>
            <div class="card-body">
                <p class="text-muted">To manage permissions for this role, use the Permissions page.</p>
                <a asp-action="Permissions" asp-route-id="@roleId" class="btn btn-outline-info">
                    <i class="bi bi-key me-1"></i>Manage Permissions
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
