@model RoleListViewModel

@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Roles</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Create New Role
    </a>
</div>

<!-- Search and Filter Form -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Search</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Role name or description..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Role Type</label>
                <select name="roleType" class="form-select">
                    <option value="">All Types</option>
                    <option value="System" selected="@(Model.RoleTypeFilter == "System")">System</option>
                    <option value="Employee" selected="@(Model.RoleTypeFilter == "Employee")">Employee</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Roles Table -->
<div class="card">
    <div class="card-body">
        @if (Model.Roles.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-lock display-4 text-muted"></i>
                <p class="mt-3 text-muted">No roles found.</p>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.RoleTypeFilter))
                {
                    <a asp-action="Index" class="btn btn-link">Clear filters</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Role Name</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Permissions</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model.Roles)
                        {
                            <tr>
                                <td><strong>@role.Name</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(role.Description))
                                    {
                                        <span title="@role.Description">
                                            @(role.Description.Length > 50 ? role.Description[..50] + "..." : role.Description)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var typeBadgeClass = role.RoleType == "System" ? "bg-primary" : "bg-info";
                                    }
                                    <span class="badge @typeBadgeClass">@role.RoleType</span>
                                </td>
                                <td>
                                    @if (role.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">@role.PermissionCount</span>
                                </td>
                                <td>
                                    <span title="@role.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                        @role.CreatedAtUtc.ToString("yyyy-MM-dd")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Permissions" asp-route-id="@role.Id" class="btn btn-sm btn-outline-info" title="Manage Permissions">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete this role?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="text-muted mt-3">
                Showing @Model.Roles.Count roles
            </div>
        }
    </div>
</div>
