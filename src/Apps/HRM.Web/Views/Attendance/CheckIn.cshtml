@model CheckInFormModel

@{
    ViewData["Title"] = "Check In";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="MyAttendance" class="btn btn-sm btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="mb-0"><i class="bi bi-box-arrow-in-right me-2 text-success"></i>Check In</h2>
        </div>

        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Leave the time field empty to use the current server time.
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card">
            <div class="card-body">
                <form asp-action="CheckIn" method="post">
                    <div class="mb-3">
                        <label asp-for="CheckInTimeUtc" class="form-label"></label>
                        <input asp-for="CheckInTimeUtc" type="datetime-local" class="form-control" />
                        <div class="form-text">Leave empty to use current time (UTC).</div>
                        <span asp-validation-for="CheckInTimeUtc" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Check In
                        </button>
                        <a asp-action="MyAttendance" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
