@model TenantResponse

@{
    ViewData["Title"] = $"Tenant - {Model.Name}";
}

<div class="row">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                @Model.Name
                @if (Model.IsSystemTenant)
                {
                    <span class="badge bg-info text-dark ms-2 fs-6"><i class="bi bi-shield-lock me-1"></i>System</span>
                }
            </h2>
            @{
                var badgeClass = Model.Status switch
                {
                    "Active" => "bg-success",
                    "Suspended" => "bg-warning text-dark",
                    "Deactivated" => "bg-secondary",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @badgeClass fs-6">@Model.Status</span>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-building me-1"></i>Tenant Details
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Tenant ID</dt>
                    <dd class="col-sm-9"><code>@Model.Id</code></dd>

                    <dt class="col-sm-3">Code</dt>
                    <dd class="col-sm-9"><code>@Model.Code</code></dd>

                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge @badgeClass">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-3">Subdomain</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.Subdomain))
                        {
                            <code>@Model.Subdomain</code>
                            <span class="text-muted ms-1">.hrm.example.com</span>
                        }
                        else
                        {
                            <em class="text-muted">Not set</em>
                        }
                    </dd>

                    <dt class="col-sm-3">System Tenant</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsSystemTenant)
                        {
                            <span class="badge bg-info text-dark"><i class="bi bi-shield-lock me-1"></i>Yes</span>
                        }
                        else
                        {
                            <span class="text-muted">No</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                    <dt class="col-sm-3">Last Modified</dt>
                    <dd class="col-sm-9">
                        @if (Model.ModifiedAtUtc.HasValue)
                        {
                            @Model.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")
                            <text> UTC</text>
                        }
                        else
                        {
                            <em>Never modified</em>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            @if (Model.Status != "Active")
            {
                <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Activate
                    </button>
                </form>
            }
            @if (Model.Status == "Active" && !Model.IsSystemTenant)
            {
                <form asp-action="Suspend" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-pause-circle me-1"></i>Suspend
                    </button>
                </form>
            }
            @if (Model.Status != "Deactivated" && !Model.IsSystemTenant)
            {
                <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to deactivate this tenant? This action is permanent.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Deactivate
                    </button>
                </form>
            }
        </div>
    </div>
</div>
