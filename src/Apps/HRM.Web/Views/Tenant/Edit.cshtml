@model EditTenantFormModel

@{
    ViewData["Title"] = $"Edit Tenant - {Model.Code}";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Edit Tenant</h2>

        <div class="alert alert-info mb-3">
            <strong>Code:</strong> <code>@Model.Code</code> &mdash;
            <strong>Status:</strong> @Model.Status
            @if (Model.IsSystemTenant)
            {
                <span class="badge bg-info text-dark ms-2"><i class="bi bi-shield-lock me-1"></i>System Tenant</span>
            }
        </div>

        @if (Model.IsSystemTenant)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                This is the system tenant. Only the name can be modified.
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="IsSystemTenant" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @if (!Model.IsSystemTenant)
            {
                <div class="mb-3">
                    <label asp-for="Subdomain" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Subdomain" class="form-control" placeholder="acme" />
                        <span class="input-group-text text-muted">.hrm.example.com</span>
                    </div>
                    <span asp-validation-for="Subdomain" class="text-danger"></span>
                    <div class="form-text">
                        3-63 lowercase letters, numbers, or hyphens. Leave empty to clear the subdomain.
                    </div>
                </div>
            }

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
