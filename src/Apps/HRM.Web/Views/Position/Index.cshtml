@model PositionListViewModel

@{
    ViewData["Title"] = "Positions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Positions</h2>
    @if (!Model.RequiresCompanySelection)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Create Position
        </a>
    }
</div>

@if (Model.RequiresCompanySelection)
{
    <div class="alert alert-warning">
        <i class="bi bi-info-circle me-2"></i>
        Please select a specific company from the <strong>Company Switcher</strong> in the navigation bar to view positions.
    </div>
}
else
{
    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by code or title..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                        <option value="Closed" selected="@(Model.StatusFilter == "Closed")">Closed</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Positions Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Positions.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-badge display-4 text-muted"></i>
                    <p class="mt-3 text-muted">No positions found.</p>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <a asp-action="Index" class="btn btn-link">Clear filters</a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Title</th>
                                <th>Level</th>
                                <th>Management</th>
                                <th>Headcount</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var position in Model.Positions)
                            {
                                <tr>
                                    <td><code>@position.Code</code></td>
                                    <td>@position.Title</td>
                                    <td>
                                        <span class="badge bg-light text-dark">@position.PositionLevel</span>
                                    </td>
                                    <td>
                                        @if (position.IsManagement)
                                        {
                                            <span class="badge bg-primary">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @(position.MaxHeadcount?.ToString() ?? "-")
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = position.Status switch
                                            {
                                                "Active" => "bg-success",
                                                "Inactive" => "bg-secondary",
                                                "Closed" => "bg-danger",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@position.Status</span>
                                    </td>
                                    <td>
                                        <span title="@position.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                            @position.CreatedAtUtc.ToString("yyyy-MM-dd")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@position.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (position.Status != "Closed")
                                        {
                                            <a asp-action="Edit" asp-route-id="@position.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted mt-3">
                    Showing @Model.Positions.Count positions
                </div>
            }
        </div>
    </div>
}
