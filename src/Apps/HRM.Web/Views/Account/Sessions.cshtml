@model SessionListViewModel

@{
    ViewData["Title"] = "Active Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Active Sessions</h2>
    @if (Model.Sessions.Count > 1)
    {
        <form asp-action="RevokeAllSessions" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger"
                    onclick="return confirm('Are you sure you want to revoke all other sessions? You will remain logged in on this device only.')">
                <i class="bi bi-shield-exclamation me-1"></i>Revoke All Other Sessions
            </button>
        </form>
    }
</div>

<p class="text-muted mb-4">
    Manage your active login sessions. If you see a session you don't recognize, revoke it immediately and change your password.
</p>

@if (Model.Sessions.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-shield-check display-4 text-muted"></i>
            <p class="mt-3 text-muted">No active sessions found.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var session in Model.Sessions.OrderByDescending(s => s.IsCurrent).ThenByDescending(s => s.CreatedAt))
        {
            <div class="col-md-6">
                <div class="card @(session.IsCurrent ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                @if (session.IsCurrent)
                                {
                                    <span class="badge bg-primary me-1">Current Session</span>
                                }
                                <span class="badge bg-success">Active</span>
                            </div>
                            @if (!session.IsCurrent)
                            {
                                <form asp-action="RevokeSession" asp-route-sessionId="@session.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to revoke this session?')">
                                        <i class="bi bi-x-lg"></i> Revoke
                                    </button>
                                </form>
                            }
                        </div>

                        <dl class="row mb-0 small">
                            <dt class="col-sm-4 text-muted">Device</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrWhiteSpace(session.UserAgent))
                                {
                                    @{
                                        var ua = session.UserAgent!;
                                        string deviceIcon;
                                        string deviceLabel;

                                        if (ua.Contains("Mobile", StringComparison.OrdinalIgnoreCase) ||
                                            ua.Contains("Android", StringComparison.OrdinalIgnoreCase) ||
                                            ua.Contains("iPhone", StringComparison.OrdinalIgnoreCase))
                                        {
                                            deviceIcon = "bi-phone";
                                            deviceLabel = "Mobile";
                                        }
                                        else if (ua.Contains("PostmanRuntime", StringComparison.OrdinalIgnoreCase) ||
                                                 ua.Contains("curl", StringComparison.OrdinalIgnoreCase))
                                        {
                                            deviceIcon = "bi-terminal";
                                            deviceLabel = "API Client";
                                        }
                                        else
                                        {
                                            deviceIcon = "bi-laptop";
                                            deviceLabel = "Desktop";
                                        }
                                    }
                                    <i class="bi @deviceIcon me-1"></i>@deviceLabel
                                    <br />
                                    <span class="text-muted text-break" style="font-size: 0.85em;">@ua</span>
                                }
                                else
                                {
                                    <span class="text-muted">Unknown device</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted">IP Address</dt>
                            <dd class="col-sm-8">
                                @(session.CreatedByIp ?? "Unknown")
                            </dd>

                            <dt class="col-sm-4 text-muted">Logged in</dt>
                            <dd class="col-sm-8">
                                <span title="@session.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                    @session.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </span>
                            </dd>

                            <dt class="col-sm-4 text-muted">Expires</dt>
                            <dd class="col-sm-8">
                                <span title="@session.ExpiresAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                    @session.ExpiresAt.ToString("yyyy-MM-dd HH:mm")
                                </span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        }
    </div>
}
