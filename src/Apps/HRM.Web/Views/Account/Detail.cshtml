@model AccountSummary

@{
    ViewData["Title"] = "Account Detail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Account Detail</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-person me-2"></i>@Model.FullName
                </h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8"><strong>@Model.Username</strong></dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </dd>

                    <dt class="col-sm-4">Account Type</dt>
                    <dd class="col-sm-8">
                        @{
                            var typeBadge = Model.AccountType switch
                            {
                                "System" => "bg-info",
                                "Employee" => "bg-primary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @typeBadge">@Model.AccountType</span>
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Active" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Suspended" => "bg-danger",
                                "Deactivated" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">
                        <span title="@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                            @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                        </span>
                    </dd>

                    <dt class="col-sm-4">Last Login</dt>
                    <dd class="col-sm-8">
                        @if (Model.LastLoginAtUtc.HasValue)
                        {
                            <span title="@Model.LastLoginAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                                @Model.LastLoginAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Never</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Actions</h5>
            </div>
            <div class="card-body d-grid gap-2">
                @if (Model.Status == "Pending")
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100"
                                onclick="return confirm('Are you sure you want to activate this account?')">
                            <i class="bi bi-check-circle me-1"></i>Activate Account
                        </button>
                    </form>
                }
                else if (Model.Status == "Active")
                {
                    <span class="text-success">
                        <i class="bi bi-check-circle-fill me-1"></i>Account is active
                    </span>
                }
                else if (Model.Status == "Suspended")
                {
                    <span class="text-danger">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>Account is suspended
                    </span>
                }
                else if (Model.Status == "Deactivated")
                {
                    <span class="text-secondary">
                        <i class="bi bi-dash-circle-fill me-1"></i>Account is deactivated
                    </span>
                }
            </div>
        </div>
    </div>
</div>
