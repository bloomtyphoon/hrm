@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) {
                return new bootstrap.Tooltip(el);
            });

            // Cross-type warning logic for role management modal
            var accountType = '@accountType';
            var warningAlert = document.getElementById('crossTypeWarning');
            var roleCheckboxes = document.querySelectorAll('.role-checkbox');

            function updateCrossTypeWarning() {
                var hasCrossType = false;
                roleCheckboxes.forEach(function (cb) {
                    if (cb.checked && cb.dataset.roleType !== accountType) {
                        hasCrossType = true;
                    }
                });
                if (warningAlert) {
                    warningAlert.classList.toggle('d-none', !hasCrossType);
                }
            }

            roleCheckboxes.forEach(function (cb) {
                cb.addEventListener('change', updateCrossTypeWarning);
            });

            updateCrossTypeWarning();
        });
    </script>
}
