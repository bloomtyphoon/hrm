@model AccountDetailViewModel

@{
    ViewData["Title"] = $"Account: {Model.Account.Username}";
    var assignedRoleIds = Model.AssignedRoles.Select(r => r.Id).ToHashSet();
    var accountType = Model.Account.AccountType;
    var rolesByType = Model.AvailableRoles.GroupBy(r => r.RoleType).OrderBy(g => g.Key);
    var typeBadge = accountType switch
    {
        "System" => "bg-info",
        "Employee" => "bg-primary",
        _ => "bg-secondary"
    };
    var statusBadge = Model.Account.Status switch
    {
        "Active" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Suspended" => "bg-danger",
        "Deactivated" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Accounts</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Account.Username</li>
    </ol>
</nav>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["TwoFactorSecretKey"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-key me-2"></i><strong>2FA Secret Key:</strong>
        <code class="ms-2">@TempData["TwoFactorSecretKey"]</code>
        <br /><small class="text-muted">Save this key securely. It will not be shown again.</small>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.Account.FullName</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge @typeBadge">@accountType</span>
            <span class="badge @statusBadge">@Model.Account.Status</span>
            @if (Model.Account.IsTwoFactorEnabled)
            {
                <span class="badge bg-success"><i class="bi bi-shield-lock me-1"></i>2FA</span>
            }
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="row">
    <!-- Left Column -->
    <div class="col-lg-6">
        <!-- Account Info Card -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-person me-2"></i>Account Information</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                    <i class="bi bi-pencil me-1"></i>Edit
                </button>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8"><code>@Model.Account.Id</code></dd>

                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8"><strong>@Model.Account.Username</strong></dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.Account.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Account.Email">@Model.Account.Email</a></dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Account.PhoneNumber))
                        {
                            @Model.Account.PhoneNumber
                        }
                        else
                        {
                            <span class="text-muted">Not set</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Account Type</dt>
                    <dd class="col-sm-8"><span class="badge @typeBadge">@accountType</span></dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @statusBadge">@Model.Account.Status</span></dd>

                    <dt class="col-sm-4">2FA</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.IsTwoFactorEnabled)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Enabled</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Account.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                    <dt class="col-sm-4">Activated</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.ActivatedAtUtc.HasValue)
                        {
                            @Model.Account.ActivatedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") <text>UTC</text>
                        }
                        else
                        {
                            <span class="text-muted">Not activated</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Last Login</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.LastLoginAtUtc.HasValue)
                        {
                            @Model.Account.LastLoginAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") <text>UTC</text>
                        }
                        else
                        {
                            <span class="text-muted">Never</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Modified</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.ModifiedAtUtc.HasValue)
                        {
                            @Model.Account.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") <text>UTC</text>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Account.Status == "Pending")
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success"
                                    onclick="return confirm('Activate this account?')">
                                <i class="bi bi-check-circle me-1"></i>Activate
                            </button>
                        </form>
                    }

                    @if (Model.Account.Status == "Active")
                    {
                        <form asp-action="Suspend" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning"
                                    onclick="return confirm('Suspend this account?')">
                                <i class="bi bi-pause-circle me-1"></i>Suspend
                            </button>
                        </form>
                        <form asp-action="Deactivate" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('Deactivate this account? This action may be difficult to reverse.')">
                                <i class="bi bi-x-circle me-1"></i>Deactivate
                            </button>
                        </form>
                    }

                    @if (Model.Account.Status == "Suspended")
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success"
                                    onclick="return confirm('Reactivate this account?')">
                                <i class="bi bi-check-circle me-1"></i>Reactivate
                            </button>
                        </form>
                    }

                    <form asp-action="Unlock" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-info"
                                onclick="return confirm('Unlock this account?')">
                            <i class="bi bi-unlock me-1"></i>Unlock
                        </button>
                    </form>

                    @if (Model.Account.IsTwoFactorEnabled)
                    {
                        <form asp-action="DisableTwoFactor" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-warning"
                                    onclick="return confirm('Disable two-factor authentication?')">
                                <i class="bi bi-shield-x me-1"></i>Disable 2FA
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="EnableTwoFactor" asp-route-id="@Model.Account.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success">
                                <i class="bi bi-shield-lock me-1"></i>Enable 2FA
                            </button>
                        </form>
                    }

                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                        <i class="bi bi-key me-1"></i>Reset Password
                    </button>
                </div>
            </div>
        </div>

        <!-- Profile Card (System or Employee) -->
        @if (accountType == "System")
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-server me-2"></i>System Profile</h6>
                    @if (Model.SystemProfile != null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editSystemProfileModal">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (Model.SystemProfile == null)
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-server display-4 text-muted"></i>
                            <p class="mt-2 text-muted">No system profile created yet.</p>
                            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createSystemProfileModal">
                                <i class="bi bi-plus-circle me-1"></i>Create System Profile
                            </button>
                        </div>
                    }
                    else
                    {
                        var sp = Model.SystemProfile;
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Super Admin</dt>
                            <dd class="col-sm-8">
                                @if (sp.IsSuperAdmin)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-star-fill me-1"></i>Yes</span>
                                    <form asp-action="RevokeSuperAdmin" asp-route-id="@Model.Account.Id" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Revoke super admin privileges?')">
                                            Revoke
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                    <form asp-action="GrantSuperAdmin" asp-route-id="@Model.Account.Id" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                onclick="return confirm('Grant super admin privileges?')">
                                            Grant
                                        </button>
                                    </form>
                                }
                            </dd>

                            <dt class="col-sm-4">Department</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(sp.Department))
                                {
                                    @sp.Department
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Job Title</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(sp.JobTitle))
                                {
                                    @sp.JobTitle
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Notes</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(sp.Notes))
                                {
                                    @sp.Notes
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Created</dt>
                            <dd class="col-sm-8">@sp.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                            @if (sp.ModifiedAtUtc.HasValue)
                            {
                                <dt class="col-sm-4">Modified</dt>
                                <dd class="col-sm-8">@sp.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                            }
                        </dl>
                    }
                </div>
            </div>
        }

        @if (accountType == "Employee")
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-person-badge me-2"></i>Employee Profile</h6>
                    @if (Model.EmployeeProfile != null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editEmployeeProfileModal">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (Model.EmployeeProfile == null)
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-person-badge display-4 text-muted"></i>
                            <p class="mt-2 text-muted">No employee profile created yet.</p>
                            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createEmployeeProfileModal">
                                <i class="bi bi-plus-circle me-1"></i>Create Employee Profile
                            </button>
                        </div>
                    }
                    else
                    {
                        var ep = Model.EmployeeProfile;
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Employee ID</dt>
                            <dd class="col-sm-7"><code>@ep.EmployeeId</code></dd>

                            <dt class="col-sm-5">Scope Level</dt>
                            <dd class="col-sm-7">
                                <span class="badge @ScopeLevelHelper.GetBadgeClass(ep.DefaultScopeLevel)">
                                    @ScopeLevelHelper.GetDisplayName(ep.DefaultScopeLevel)
                                </span>
                            </dd>

                            <dt class="col-sm-5">Access All Companies</dt>
                            <dd class="col-sm-7">
                                @if (ep.CanAccessAllAssignedCompanies)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </dd>

                            @if (ep.PrimaryCompanyId.HasValue)
                            {
                                <dt class="col-sm-5">Primary Company</dt>
                                <dd class="col-sm-7"><code>@ep.PrimaryCompanyId</code></dd>
                            }
                            @if (ep.PrimaryDepartmentId.HasValue)
                            {
                                <dt class="col-sm-5">Primary Department</dt>
                                <dd class="col-sm-7"><code>@ep.PrimaryDepartmentId</code></dd>
                            }
                            @if (ep.PrimaryPositionId.HasValue)
                            {
                                <dt class="col-sm-5">Primary Position</dt>
                                <dd class="col-sm-7"><code>@ep.PrimaryPositionId</code></dd>
                            }

                            <dt class="col-sm-5">Created</dt>
                            <dd class="col-sm-7">@ep.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                            @if (ep.ModifiedAtUtc.HasValue)
                            {
                                <dt class="col-sm-5">Modified</dt>
                                <dd class="col-sm-7">@ep.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                            }
                        </dl>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Roles -->
    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-shield-check me-2"></i>Assigned Roles (@Model.AssignedRoles.Count)</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageRolesModal">
                    <i class="bi bi-pencil me-1"></i>Manage Roles
                </button>
            </div>
            <div class="card-body">
                @if (Model.AssignedRoles.Count == 0)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-shield-x display-4 text-muted"></i>
                        <p class="mt-3 text-muted">No roles assigned to this account.</p>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageRolesModal">
                            <i class="bi bi-plus-circle me-1"></i>Assign Roles
                        </button>
                    </div>
                }
                else
                {
                    var assignedByType = Model.AssignedRoles.GroupBy(r => r.RoleType).OrderBy(g => g.Key);
                    foreach (var typeGroup in assignedByType)
                    {
                        var typeBadgeClass = typeGroup.Key == "System" ? "bg-primary" : "bg-info";
                        var isCrossTypeAssigned = typeGroup.Key != accountType;
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge @typeBadgeClass me-2">@typeGroup.Key</span>
                                <small class="text-muted">@typeGroup.Count() role(s)</small>
                                @if (isCrossTypeAssigned)
                                {
                                    <span class="badge bg-warning text-dark ms-2" data-bs-toggle="tooltip"
                                          title="Cross-type assignment: @typeGroup.Key roles assigned to @accountType account">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </span>
                                }
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var role in typeGroup.OrderBy(r => r.Name))
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                        <div>
                                            <strong>@role.Name</strong>
                                            @if (!string.IsNullOrEmpty(role.Description))
                                            {
                                                <br /><small class="text-muted">@role.Description</small>
                                            }
                                        </div>
                                        <span class="badge bg-light text-dark">@role.PermissionCount permissions</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- ========== MODALS ========== -->

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateProfile" asp-route-id="@Model.Account.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person me-2"></i>Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="fullName" name="fullName"
                               value="@Model.Account.FullName" required />
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="text" class="form-control" id="phoneNumber" name="phoneNumber"
                               value="@Model.Account.PhoneNumber" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ChangePassword" asp-route-id="@Model.Account.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-key me-2"></i>Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        This will reset the password for <strong>@Model.Account.Username</strong>.
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="8" />
                        <div class="form-text">Minimum 8 characters.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-key me-1"></i>Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manage Roles Modal -->
<div class="modal fade" id="manageRolesModal" tabindex="-1" aria-labelledby="manageRolesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AssignRoles" asp-route-id="@Model.Account.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="manageRolesModalLabel">
                        <i class="bi bi-shield-check me-2"></i>Manage Roles for @Model.Account.Username
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.AvailableRoles.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            No active roles available. Please create roles first.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-3">
                            Select roles for this <strong>@accountType</strong> account:
                        </p>

                        <div id="crossTypeWarning" class="alert alert-warning d-none mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Note:</strong> You are assigning roles from a different type than the account type.
                        </div>

                        @foreach (var roleGroup in rolesByType)
                        {
                            var groupRoleType = roleGroup.Key;
                            var isCrossType = groupRoleType != accountType;
                            var groupBadgeClass = groupRoleType == "System" ? "bg-primary" : "bg-info";

                            <div class="card mb-3 @(isCrossType ? "border-warning" : "")">
                                <div class="card-header d-flex align-items-center @(isCrossType ? "bg-warning bg-opacity-10" : "")">
                                    <span class="badge @groupBadgeClass me-2">@groupRoleType</span>
                                    <span class="fw-semibold">@groupRoleType Roles</span>
                                    @if (isCrossType)
                                    {
                                        <span class="badge bg-warning text-dark ms-auto">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Cross-type
                                        </span>
                                    }
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        @foreach (var role in roleGroup.OrderBy(r => r.Name))
                                        {
                                            var isAssigned = assignedRoleIds.Contains(role.Id);
                                            <div class="col-md-6 mb-2">
                                                <div class="form-check">
                                                    @if (isAssigned)
                                                    {
                                                        <input type="checkbox"
                                                               class="form-check-input role-checkbox"
                                                               id="role-@role.Id"
                                                               name="roleIds"
                                                               value="@role.Id"
                                                               data-role-type="@role.RoleType"
                                                               checked="checked" />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox"
                                                               class="form-check-input role-checkbox"
                                                               id="role-@role.Id"
                                                               name="roleIds"
                                                               value="@role.Id"
                                                               data-role-type="@role.RoleType" />
                                                    }
                                                    <label class="form-check-label" for="role-@role.Id">
                                                        <strong>@role.Name</strong>
                                                        <br />
                                                        <small class="text-muted">
                                                            @(role.Description ?? "No description")
                                                            <span class="badge bg-light text-dark ms-1">@role.PermissionCount perm.</span>
                                                        </small>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    @if (Model.AvailableRoles.Count > 0)
                    {
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

