@model AccountDetailViewModel

@{
    ViewData["Title"] = $"Account: {Model.Account.Username}";
    var assignedRoleIds = Model.AssignedRoles.Select(r => r.Id).ToHashSet();
    var accountType = Model.Account.AccountType;
    var rolesByType = Model.AvailableRoles.GroupBy(r => r.RoleType).OrderBy(g => g.Key);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Accounts</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Account.Username</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.Account.FullName</h2>
        <div class="d-flex gap-2">
            @{
                var typeBadge = Model.Account.AccountType switch
                {
                    "System" => "bg-info",
                    "Employee" => "bg-primary",
                    _ => "bg-secondary"
                };
                var statusBadge = Model.Account.Status switch
                {
                    "Active" => "bg-success",
                    "Pending" => "bg-warning text-dark",
                    "Suspended" => "bg-danger",
                    "Deactivated" => "bg-secondary",
                    _ => "bg-secondary"
                };
            }
            <span class="badge @typeBadge">@Model.Account.AccountType</span>
            <span class="badge @statusBadge">@Model.Account.Status</span>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="row">
    <!-- Account Info -->
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-person me-2"></i>Account Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8"><code>@Model.Account.Id</code></dd>

                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8"><strong>@Model.Account.Username</strong></dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.Account.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">
                        <a href="mailto:@Model.Account.Email">@Model.Account.Email</a>
                    </dd>

                    <dt class="col-sm-4">Account Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge @typeBadge">@Model.Account.AccountType</span>
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @statusBadge">@Model.Account.Status</span>
                    </dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">
                        @Model.Account.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                    </dd>

                    <dt class="col-sm-4">Last Login</dt>
                    <dd class="col-sm-8">
                        @if (Model.Account.LastLoginAtUtc.HasValue)
                        {
                            @Model.Account.LastLoginAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss")
                            <text> UTC</text>
                        }
                        else
                        {
                            <span class="text-muted">Never</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Actions</h6>
            </div>
            <div class="card-body d-grid gap-2">
                @if (Model.Account.Status == "Pending")
                {
                    <form asp-action="Activate" asp-route-id="@Model.Account.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100"
                                onclick="return confirm('Are you sure you want to activate this account?')">
                            <i class="bi bi-check-circle me-1"></i>Activate Account
                        </button>
                    </form>
                }
                else if (Model.Account.Status == "Active")
                {
                    <div class="text-success">
                        <i class="bi bi-check-circle-fill me-1"></i>Account is active
                    </div>
                }
                else if (Model.Account.Status == "Suspended")
                {
                    <div class="text-danger">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>Account is suspended
                    </div>
                }
                else if (Model.Account.Status == "Deactivated")
                {
                    <div class="text-secondary">
                        <i class="bi bi-dash-circle-fill me-1"></i>Account is deactivated
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Roles Section -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-shield-check me-2"></i>Assigned Roles (@Model.AssignedRoles.Count)</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageRolesModal">
                    <i class="bi bi-pencil me-1"></i>Manage Roles
                </button>
            </div>
            <div class="card-body">
                @if (Model.AssignedRoles.Count == 0)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-shield-x display-4 text-muted"></i>
                        <p class="mt-3 text-muted">No roles assigned to this account.</p>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageRolesModal">
                            <i class="bi bi-plus-circle me-1"></i>Assign Roles
                        </button>
                    </div>
                }
                else
                {
                    var assignedByType = Model.AssignedRoles.GroupBy(r => r.RoleType).OrderBy(g => g.Key);
                    foreach (var typeGroup in assignedByType)
                    {
                        var typeBadgeClass = typeGroup.Key == "System" ? "bg-primary" : "bg-info";
                        var isCrossTypeAssigned = typeGroup.Key != accountType;
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge @typeBadgeClass me-2">@typeGroup.Key</span>
                                <small class="text-muted">@typeGroup.Count() role(s)</small>
                                @if (isCrossTypeAssigned)
                                {
                                    <span class="badge bg-warning text-dark ms-2" data-bs-toggle="tooltip"
                                          title="Cross-type assignment: @typeGroup.Key roles assigned to @accountType account">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </span>
                                }
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var role in typeGroup.OrderBy(r => r.Name))
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                        <div>
                                            <strong>@role.Name</strong>
                                            @if (!string.IsNullOrEmpty(role.Description))
                                            {
                                                <br /><small class="text-muted">@role.Description</small>
                                            }
                                        </div>
                                        <span class="badge bg-light text-dark">@role.PermissionCount permissions</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Manage Roles Modal -->
<div class="modal fade" id="manageRolesModal" tabindex="-1" aria-labelledby="manageRolesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AssignRoles" asp-route-id="@Model.Account.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="manageRolesModalLabel">
                        <i class="bi bi-shield-check me-2"></i>Manage Roles for @Model.Account.Username
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.AvailableRoles.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            No active roles available. Please create roles first.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-3">
                            Select roles for this <strong>@accountType</strong> account:
                        </p>

                        <!-- Cross-type warning alert (hidden by default, shown via JS) -->
                        <div id="crossTypeWarning" class="alert alert-warning d-none mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Note:</strong> You are assigning roles from a different type than the account type.
                            This may require additional approval depending on your organization's policy.
                        </div>

                        @foreach (var roleGroup in rolesByType)
                        {
                            var groupRoleType = roleGroup.Key;
                            var isCrossType = groupRoleType != accountType;
                            var groupBadgeClass = groupRoleType == "System" ? "bg-primary" : "bg-info";
                            var groupTooltip = groupRoleType == "System"
                                ? "System roles are for administrative and service accounts with elevated privileges"
                                : "Employee roles are for regular staff members with standard business permissions";

                            <div class="card mb-3 @(isCrossType ? "border-warning" : "")">
                                <div class="card-header d-flex align-items-center @(isCrossType ? "bg-warning bg-opacity-10" : "")">
                                    <span class="badge @groupBadgeClass me-2">@groupRoleType</span>
                                    <span class="fw-semibold">@groupRoleType Roles</span>
                                    <span class="ms-2 text-muted" data-bs-toggle="tooltip" title="@groupTooltip">
                                        <i class="bi bi-info-circle"></i>
                                    </span>
                                    @if (isCrossType)
                                    {
                                        <span class="badge bg-warning text-dark ms-auto" data-bs-toggle="tooltip"
                                              title="This account is @accountType type. Assigning @groupRoleType roles may require approval.">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Cross-type
                                        </span>
                                    }
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        @foreach (var role in roleGroup.OrderBy(r => r.Name))
                                        {
                                            var isAssigned = assignedRoleIds.Contains(role.Id);
                                            <div class="col-md-6 mb-2">
                                                <div class="form-check">
                                                    <input type="checkbox"
                                                           class="form-check-input role-checkbox"
                                                           id="role-@role.Id"
                                                           name="roleIds"
                                                           value="@role.Id"
                                                           data-role-type="@role.RoleType"
                                                           @(isAssigned ? "checked" : "") />
                                                    <label class="form-check-label" for="role-@role.Id">
                                                        <strong>@role.Name</strong>
                                                        <br />
                                                        <small class="text-muted">
                                                            @(role.Description ?? "No description")
                                                            <span class="badge bg-light text-dark ms-1">@role.PermissionCount permissions</span>
                                                        </small>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </button>
                    @if (Model.AvailableRoles.Count > 0)
                    {
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Cross-type warning logic
            var accountType = '@accountType';
            var warningAlert = document.getElementById('crossTypeWarning');
            var roleCheckboxes = document.querySelectorAll('.role-checkbox');

            function updateCrossTypeWarning() {
                var hasCrossTypeSelection = false;
                roleCheckboxes.forEach(function (cb) {
                    if (cb.checked && cb.dataset.roleType !== accountType) {
                        hasCrossTypeSelection = true;
                    }
                });

                if (hasCrossTypeSelection) {
                    warningAlert.classList.remove('d-none');
                } else {
                    warningAlert.classList.add('d-none');
                }
            }

            // Attach event listeners
            roleCheckboxes.forEach(function (cb) {
                cb.addEventListener('change', updateCrossTypeWarning);
            });

            // Initial check
            updateCrossTypeWarning();
        });
    </script>
}
