{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HrmDatabase": "Server=localhost;Database=HrmDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-jwt-key-min-32-characters-for-production",
    "Issuer": "HRM.Api",
    "Audience": "HRM.Clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RememberMeExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "OutboxSettings": {
    "PollingIntervalSeconds": 60,
    "BatchSize": 100,
    "MaxAttempts": 5
  },
  "DatabaseSettings": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30
  },
  "IdentityCacheSettings": {
    "PermissionCacheDurationMinutes": 5,
    "CatalogCacheDurationMinutes": 60,
    "DataScopeRuleCacheDurationMinutes": 5
  }
}
